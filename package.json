{
  "name": "kinoplyonka-bot",
  "version": "1.0.0",
  "description": "Telegram movie catalog bot \"Киноплёнка\" running on Cloudflare Workers + D1",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute kinoplyonka-db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute kinoplyonka-db --remote --file=./schema.sql",
    "webhook:set": "node scripts/set-webhook.js",
    "webhook:info": "node scripts/webhook-info.js",
    "webhook:delete": "node scripts/delete-webhook.js"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
